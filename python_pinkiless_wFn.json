{
  "title": "python_pinkiless_wFn",
  "rules": [
    {
      "description": "python_pinkiless_wFn: hold w for core symbol layer",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "w",
            "modifiers": { "optional": ["any"] }
          },

          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200,
            "basic.to_if_held_down_threshold_milliseconds": 200
          },

          "to_if_alone": [
            {
              "key_code": "w"
            }
          ],

          "to_if_held_down": [
            {
              "set_variable": {
                "name": "python_pinkiless_wfn",
                "value": 1
              }
            }
          ],

          "to_after_key_up": [
            {
              "set_variable": {
                "name": "python_pinkiless_wfn",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_wfn",
              "value": 1
            }
          ],
          "from": { "key_code": "n" },
          "to": [
            {
              "key_code": "return_or_enter"
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_wfn",
              "value": 1
            }
          ],
          "from": { "key_code": "e" },
          "to": [
            {
              "key_code": "semicolon",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_wfn",
              "value": 1
            }
          ],
          "from": { "key_code": "i" },
          "to": [
            {
              "key_code": "0",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_wfn",
              "value": 1
            }
          ],
          "from": { "key_code": "o" },
          "to": [
            {
              "key_code": "9",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_wfn",
              "value": 1
            }
          ],
          "from": { "key_code": "u" },
          "to": [
            {
              "key_code": "delete_or_backspace"
            }
          ]
        }
      ]
    }
  ]
}
{
  "title": "global_symbols",
  "rules": [
    {
      "description": "5 -> +",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "5"
          },
          "to": [
            {
              "key_code": "equal_sign",
              "modifiers": ["left_shift"]
            }
          ]
        }
      ]
    },
    {
      "description": "9 -> _",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "9"
          },
          "to": [
            {
              "key_code": "hyphen",
              "modifiers": ["left_shift"]
            }
          ]
        }
      ]
    }
  ]
}
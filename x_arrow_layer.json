{
  "title": "x_arrow_layer",
  "rules": [
    {
      "description": "Hold x for arrow layer",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "x",
            "modifiers": { "optional": ["any"] }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 300,
            "basic.to_if_held_down_threshold_milliseconds": 300
          },
          "to_if_alone": [{ "key_code": "x" }],
          "to_if_held_down": [
            { "set_variable": { "name": "x_arrow_layer", "value": 1 } }
          ],
          "to_after_key_up": [
            { "set_variable": { "name": "x_arrow_layer", "value": 0 } }
          ]
        },

        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "x_arrow_layer", "value": 1 }],
          "from": { "key_code": "n"  },
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "x_arrow_layer", "value": 1 }],
          "from": { "key_code": "e"  },
          "to": [{ "key_code": "down_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "x_arrow_layer", "value": 1 }],
          "from": { "key_code": "i"  },
          "to": [{ "key_code": "right_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "x_arrow_layer", "value": 1 }],
          "from": { "key_code": "o"  },
          "to": [{ "key_code": "up_arrow" }]
        }
      ]
    }
  ]
}
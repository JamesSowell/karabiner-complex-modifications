{
  "title": "SpaceFn",
  "rules": [
    {
      "description": "SpaceFn: hold space for layer, tap space for space",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "set_variable": {
                "name": "spacefn",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "spacefn",
                "value": 0
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "spacebar"
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "spacefn",
              "value": 1
            }
          ],
          "from": { "key_code": "o" },
          "to": [
            {
              "key_code": "9",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "spacefn",
              "value": 1
            }
          ],
          "from": { "key_code": "i" },
          "to": [
            {
              "key_code": "0",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "spacefn",
              "value": 1
            }
          ],
          "from": { "key_code": "e" },
          "to": [
            {
              "key_code": "semicolon",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "spacefn",
              "value": 1
            }
          ],
          "from": { "key_code": "n" },
          "to": [
            {
              "key_code": "return_or_enter"
            }
          ]
        }
      ]
    }
  ]
}
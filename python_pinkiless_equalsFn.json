{
  "title": "python_pinkiless_equalsFn",
  "rules": [
    {
      "description": "python_pinkiless_equalsFn: hold = for core symbol layer",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "equal_sign",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "set_variable": {
                "name": "python_pinkiless_equalsfn",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "python_pinkiless_equalsfn",
                "value": 0
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "equal_sign"
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_equalsfn",
              "value": 1
            }
          ],
          "from": { "key_code": "n" }
          ,
          "to": [
            {
              "key_code": "return_or_enter"
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_equalsfn",
              "value": 1
            }
          ],
          "from": { "key_code": "e" },
          "to": [
            {
              "key_code": "semicolon",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_equalsfn",
              "value": 1
            }
          ],
          "from": { "key_code": "i" },
          "to": [
            {
              "key_code": "0",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_equalsfn",
              "value": 1
            }
          ],
          "from": { "key_code": "o" },
          "to": [
            {
              "key_code": "9",
              "modifiers": ["left_shift"]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "python_pinkiless_equalsfn",
              "value": 1
            }
          ],
          "from": { "key_code": "m" },
          "to": [
            {
              "key_code": "delete_or_backspace"
            }
          ]
        }
      ]
    }
  ]
}
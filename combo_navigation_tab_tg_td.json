{
  "title": "combo_tab_navigation_tg_td",
  "rules": [
    {
      "description": "tg -> tab, td -> shift+tab",

      "manipulators": [
        {
          "type": "basic",

          "from": {
            "simultaneous": [
              { "key_code": "t" },
              { "key_code": "g" }
            ],

            "simultaneous_options": {
              "key_down_order": "insensitive",
              "key_up_order": "insensitive",
              "key_up_when": "any",
              "detect_key_down_uninterruptedly": true
            },

            "modifiers": {
              "optional": ["any"]
            }
          },

          "to": [
            {
              "key_code": "tab"
            }
          ]
        },

        {
          "type": "basic",

          "from": {
            "simultaneous": [
              { "key_code": "t" },
              { "key_code": "d" }
            ],

            "simultaneous_options": {
              "key_down_order": "insensitive",
              "key_up_order": "insensitive",
              "key_up_when": "any",
              "detect_key_down_uninterruptedly": true
            },

            "modifiers": {
              "optional": ["any"]
            }
          },

          "to": [
            {
              "key_code": "tab",
              "modifiers": ["left_shift"]
            }
          ]
        }
      ]
    }
  ]
}
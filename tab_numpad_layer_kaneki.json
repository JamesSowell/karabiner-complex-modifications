{
  "title": "tab_numpad_layer_kaneki",
  "rules": [
    {
      "description": "Hold tab for numpad layer - kaneki",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": { "optional": ["any"] }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 300,
            "basic.to_if_held_down_threshold_milliseconds": 300
          },
          "to_if_alone": [{ "key_code": "tab" }],
          "to_if_held_down": [
            { "set_variable": { "name": "tab_numpad_layer", "value": 1 } }
          ],
          "to_after_key_up": [
            { "set_variable": { "name": "tab_numpad_layer", "value": 0 } }
          ]
        },

        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "m" },
          "to": [{ "key_code": "7" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "f" },
          "to": [{ "key_code": "8" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "u" },
          "to": [{ "key_code": "9" }]
        },

        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "n" },
          "to": [{ "key_code": "4" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "e" },
          "to": [{ "key_code": "5" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "i" },
          "to": [{ "key_code": "6" }]
        },

        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "h" },
          "to": [{ "key_code": "1" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "quote" },
          "to": [{ "key_code": "2" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "period" },
          "to": [{ "key_code": "3" }]
        },

        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "tab_numpad_layer", "value": 1 }],
          "from": { "key_code": "escape" },
          "to": [{ "key_code": "0" }]
        },
        {
        "type": "basic",
        "conditions": [
            {
            "type": "variable_if",
            "name": "tab_numpad_layer",
            "value": 1
            }
        ],
        "from": {
            "key_code": "8"
        },
        "to": [
            {
            "key_code": "8",
            "modifiers": [
                "left_shift"
            ]
            }
        ]
        },
        {
        "type": "basic",
        "conditions": [
            {
            "type": "variable_if",
            "name": "tab_numpad_layer",
            "value": 1
            }
        ],
        "from": {
            "key_code": "right_shift"
        },
        "to": [
            {
            "key_code": "return_or_enter"
            }
        ]
        },
        {
        "type": "basic",
        "conditions": [
            {
            "type": "variable_if",
            "name": "tab_numpad_layer",
            "value": 1
            }
        ],
        "from": {
            "key_code": "y"
        },
        "to": [
            {
            "key_code": "equal_sign",
            "modifiers": [
                "left_shift"
            ]
            }
        ]
        },
        {
        "type": "basic",
        "conditions": [
            {
            "type": "variable_if",
            "name": "tab_numpad_layer",
            "value": 1
            }
        ],
        "from": {
            "key_code": "open_bracket"
        },
        "to": [
            {
            "key_code": "hyphen"
            }
        ]
        },
        {
        "type": "basic",
        "conditions": [
            {
            "type": "variable_if",
            "name": "tab_numpad_layer",
            "value": 1
            }
        ],
        "from": {
            "key_code": "right_option"
        },
        "to": [
            {
            "key_code": "period"
            }
        ]
        },
         {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "tab_numpad_layer",
              "value": 1
            }
          ],
          "from": {
            "key_code": "k"
          },
          "to": [
            {
              "key_code": "slash"
            }
          ]
        }
      ]
    }
  ]
}
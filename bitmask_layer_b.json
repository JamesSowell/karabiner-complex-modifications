                "left_shift"
              ]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "bitmask_layer",
              "value": 1
            }
          ],
          "from": {
            "key_code": "u"
          },
          "to": [
            {
              "key_code": "6",
              "modifiers": [
                "left_shift"
              ]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "bitmask_layer",
              "value": 1
            }
          ],
          "from": {
            "key_code": "h"
          },
          "to": [

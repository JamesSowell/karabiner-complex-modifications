{
  "title": "bitmask_layer_b",
  "rules": [
    {
      "description": "Hold b for bitmask operators",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "bitmask_layer",
                "value": 1
              }
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "bitmask_layer",
                "value": 0
              }
            }
          ],
          "to_if_alone": [
            {
              "key_code": "b"
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "bitmask_layer",
              "value": 1
            }
          ],
          "from": {
            "key_code": "n"
          },
          "to": [
            {
              "key_code": "equal_sign"
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "bitmask_layer",
              "value": 1
            }
          ],
          "from": {
            "key_code": "e"
          },
          "to": [
            {
              "key_code": "7",
              "modifiers": [
                "left_shift"
              ]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "bitmask_layer",
              "value": 1
            }
          ],
          "from": {
            "key_code": "i"
          },
          "to": [
            {
              "key_code": "1"
            }
          ]
        },

        {
          "type": "basic",

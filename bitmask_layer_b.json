            {
              "type": "variable_if",
              "name": "bitmask_layer",
              "value": 1
            }
          ],
          "from": {
            "key_code": "o"
          },
          "to": [
            {
              "key_code": "backslash",
              "modifiers": [
                "left_shift"
              ]
            }
          ]
        },

        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "bitmask_layer",
              "value": 1
            }
          ],
